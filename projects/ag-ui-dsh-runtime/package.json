{
  "name": "hands-on-dsh-ag-ui-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:web": "vitest run tests/web",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "lint": "oxlint --deny-warnings .",
    "format:check": "oxfmt --check .",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:web": "vite build",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "server:fake": "tsx src/server/entry.ts --runtime fake --host 127.0.0.1 --port 4317",
    "server:source": "tsx src/server/entry.ts --runtime source --host 127.0.0.1 --port 4317",
    "start:fake": "node dist/server/server/entry.js --runtime fake --host 127.0.0.1 --port 4317 --serve-web",
    "start:source": "node dist/server/server/entry.js --runtime source --host 127.0.0.1 --port 4317 --serve-web",
    "smoke:server": "node scripts/server-smoke.mjs",
    "prepare:runtime-attestation": "tsx scripts/prepare-runtime-attestation.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@ag-ui/encoder": "0.0.57",
    "@copilotkit/react-core": "1.69.3",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@fastify/static": "8.3.0",
    "@hands-on-dsh/cordis-plugin-lifecycle": "file:../../labs/cordis-plugin-lifecycle",
    "fastify": "5.12.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "26.1.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.76.0",
    "rxjs": "7.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}

{
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client"]
  },
  "include": [
    "src/web/**/*.ts",
    "src/web/**/*.tsx",
    "src/shared/**/*.ts",
    "tests/web/**/*.ts",
    "tests/web/**/*.tsx",
    "vite.config.ts"
  ]
}

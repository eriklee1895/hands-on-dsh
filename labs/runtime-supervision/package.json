{
  "name": "hands-on-dsh-runtime-supervision",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format:check": "oxfmt --check .",
    "smoke": "node --import tsx examples/handshake.ts",
    "demo": "node --import tsx examples/run.ts",
    "pool:faults": "node --import tsx examples/pool-faults.ts",
    "pool:demo": "node --import tsx examples/pool.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.76.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}

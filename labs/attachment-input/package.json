{
  "name": "hands-on-dsh-attachment-input",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format:check": "oxfmt --check .",
    "live": "node --import tsx examples/live.ts",
    "live:inline": "node --import tsx examples/live.ts --files=reject-all",
    "live:partial": "node --import tsx examples/live.ts --files=reject-after-first",
    "budget:reject": "node --import tsx examples/live.ts --files=reject-all --budget=reject",
    "budget:offload": "node --import tsx examples/live.ts --files=reject-all --budget=offload",
    "live:stale": "node --import tsx examples/live.ts --files=stale-once"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction-image-offload": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-rc.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.76.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}

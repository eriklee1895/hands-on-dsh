{
  "name": "@hands-on-dsh/cordis-plugin-lifecycle",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tool": {
      "types": "./dist/plugins/tool.d.ts",
      "default": "./dist/plugins/tool.js"

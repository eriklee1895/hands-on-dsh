{
  "name": "hands-on-dsh-sandbox-isolation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format:check": "oxfmt --check .",
    "probe": "pnpm build && node --import tsx examples/provider.ts",
    "model": "pnpm build && node --import tsx examples/model.ts",
    "container": "bash examples/container.sh",
    "container:test": "DSH_CONTAINER_TEST=1 vitest run tests/container.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-fs-ssh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sandbox-ssh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-ssh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subprocess-ssh": "0.1.7-rc.2"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.76.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
